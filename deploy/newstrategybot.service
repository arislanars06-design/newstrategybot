[Unit]
Description=newstrategybot — Binance Futures grid-block trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust these to match your VPS user and install location.
User=botuser
Group=botuser
WorkingDirectory=/opt/newstrategybot

# Use the venv interpreter directly so PATH does not matter.
ExecStart=/opt/newstrategybot/.venv/bin/python -m src.main

# Reload .env on restart.
EnvironmentFile=/opt/newstrategybot/.env

Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=10

# Hardening — feel free to relax if it breaks anything on your distro.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/newstrategybot/data /opt/newstrategybot/logs

# Forward stdout/stderr to journald so `journalctl -u newstrategybot` works.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
