# ===========================================================================
#   Futures bot — example environment file
#
#   Copy this file to the repository root as `.env` (alongside the existing
#   crypto-bot variables) and fill in the values marked with <…>.
#
#   Every variable here is prefixed with FB_ so the futures bot and the
#   crypto bot can share one .env file without collisions.
# ===========================================================================

# ---- MT5 / Exness broker --------------------------------------------------

# Hostname of the mt5linux RPC server. From outside the Docker compose
# network this is 127.0.0.1; from inside (recommended in production)
# it is the compose service name, "mt5".
FB_MT5_HOST=127.0.0.1
FB_MT5_PORT=8001

# Your Exness MT5 credentials. "Demo" servers look like
# "Exness-MT5Trial7"; "Real" servers like "Exness-MT5Real8". You see
# them when logging into the MT5 terminal — copy them verbatim.
FB_MT5_LOGIN=<login_number>
FB_MT5_PASSWORD=<password>
FB_MT5_SERVER=<exness-server-name>

# Set to 1 / true / yes to run with the in-memory MockAdapter instead
# of MT5. Useful for the bring-up phase before you have an Exness
# demo account, or for quick UI sanity checks.
FB_USE_MOCK_ADAPTER=0


# ---- Telegram bot ---------------------------------------------------------

# Token from @BotFather for the dedicated futures bot — DO NOT reuse
# the crypto bot's token. Separate bots avoid command-name collisions
# and let the crypto and futures notification streams be muted
# independently.
FB_TELEGRAM_BOT_TOKEN=<futures_bot_token>

# Comma-separated Telegram user IDs allowed to issue commands. Anyone
# else is silently rejected by the allow-list middleware. Look up
# your ID with @userinfobot.
FB_TELEGRAM_ALLOWED_USER_IDS=<your_user_id>

# Chat ID where the bot DMs you — typically your personal user ID
# (positive) or a group ID (negative). All per-block events go here.
FB_TELEGRAM_NOTIFY_CHAT_ID=<your_user_id>

# Optional broadcast channel for high-signal events only (BLOCK_CREATED,
# BLOCK_WIN, BLOCK_LOSS, BLOCK_INVALID, BLOCK_ERROR). Leave blank or
# unset to disable. Channel IDs are usually negative (e.g.
# -1001234567890). The bot must be admin in the channel with
# "Post Messages" permission.
FB_TELEGRAM_NOTIFY_CHANNEL_ID=


# ---- Database -------------------------------------------------------------

# Default lands the SQLite file under ./data/futures_bot.db so it sits
# alongside the crypto bot's data without colliding. Override with a
# PostgreSQL URL once you scale beyond one-machine deployments.
FB_DATABASE_URL=sqlite+aiosqlite:///./data/futures_bot.db


# ---- Strategy knobs -------------------------------------------------------

# How to round the per-rung lot to the broker's volume_step grid:
#   "up"     — strict ceil (chosen — preserves planned risk)
#   "down"   — strict floor (safer, under-risks)
#   "nearest"— banker's rounding
FB_LOT_ROUNDING=up

# Spread × this factor is the buffer between rung N's SL and rung N+1's
# entry. 1.5 is the discussed default: enough margin for normal-session
# jitter without burning more than a fraction of a rung's risk.
FB_SL_SPREAD_SAFETY=1.5

# Cumulative-risk multiplier in TP_gross = TP_MULTIPLIER × cumulative.
# Re-shaping this changes the whole pay-off table; keep at 3 unless
# backtests say otherwise.
FB_TP_MULTIPLIER=3.0

# 1.5 ^ rung-index growth in dollar risk per rung. Changing this also
# requires re-checking the TP multiplier; the two were tuned together.
FB_RISK_PROGRESSION=1.5

# Hard cap on cumulative open-block risk vs equity (percent). The
# /newblock handler refuses to open a block if the new max-loss
# would push total risk above this.
FB_MAX_DAILY_LOSS_PCT=5.0


# ---- Engine ---------------------------------------------------------------

# Polling cadence for MT5 ticks (milliseconds). Lower = faster fill
# detection; higher = lighter RPC load on the Wine container.
FB_TICK_POLL_INTERVAL_MS=500


# ---- Logging --------------------------------------------------------------

FB_LOG_LEVEL=INFO
FB_LOG_FILE=./logs/futures_bot.log
