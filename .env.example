# =============================================================================
# newstrategybot configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Binance Futures API ---
# Create an API key at https://www.binance.com/en/my/settings/api-management
# IMPORTANT: For initial testing, use the testnet (https://testnet.binancefuture.com)
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Set to "true" to use Binance Futures TESTNET. Set to "false" for live trading.
BINANCE_TESTNET=true

# --- Telegram Bot ---
# Create a bot via @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Comma-separated list of Telegram user IDs that are allowed to control the bot.
# Get your ID from @userinfobot. Only these users can issue commands.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Chat ID where notifications should be sent. Usually the same as the
# allowed user ID for a private chat. For groups, use the negative group ID.
TELEGRAM_NOTIFY_CHAT_ID=123456789

# OPTIONAL: a public or private Telegram channel that receives a copy
# of every important block event (BLOCK_CREATED, BLOCK_WIN, BLOCK_LOSS,
# BLOCK_INVALID, BLOCK_ERROR). Bot must be added as an admin of the
# channel with "Post messages" permission. Use the negative numeric ID
# Telegram assigns to channels (run /id in @userinfobot inside the
# channel, or use https://t.me/getidsbot). Leave empty to disable.
# TELEGRAM_NOTIFY_CHANNEL_ID=-1001234567890

# --- Database ---
# SQLite by default. For production on a VPS you may switch to PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/newstrategybot
DATABASE_URL=sqlite+aiosqlite:///./data/newstrategybot.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/bot.log

# --- Engine ---
# How long to wait between exchange order placements within one block (ms).
# Helps avoid Binance rate limits.
ORDER_PLACE_DELAY_MS=80

# Reconcile interval (seconds): how often to compare local DB with exchange
# state to detect missed events (e.g. after WebSocket reconnect).
RECONCILE_INTERVAL_SEC=30
